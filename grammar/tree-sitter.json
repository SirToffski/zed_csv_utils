{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "csv",
      "camelcase": "Csv",
      "title": "Rainbow CSV (comma)",
      "scope": "source.csv",
      "file-types": ["csv"],
      "path": "csv"
    },
    {
      "name": "ssv",
      "camelcase": "Ssv",
      "title": "Rainbow CSV (semicolon)",
      "scope": "source.ssv",
      "path": "ssv"
    },
    {
      "name": "psv",
      "camelcase": "Psv",
      "title": "Rainbow CSV (pipe)",
      "scope": "source.psv",
      "path": "psv"
    },
    {
      "name": "tsv",
      "camelcase": "Tsv",
      "title": "Rainbow TSV (tab)",
      "scope": "source.tsv",
      "file-types": ["tsv"],
      "path": "tsv"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Rainbow CSV/TSV grammars for the Zed extension",
    "links": {
      "repository": "https://github.com/SirToffski/zed_csv_utils"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
